# Copy to .env and adjust.
#
# All of these (except HOST_PORT) are read by Nuxt's runtimeConfig via its
# NUXT_<KEY> convention at container *start* time, not baked in at build
# time -- so changing one needs a restart, not a rebuild. nuxt.config.ts
# holds the literal defaults these override.

# --- Operation mode ---------------------------------------------------------
# "fake": GTFS schedule only, never calls Databus. Default.
# "real": poll Databus for live arrivals, auto-falling back to the schedule
#         when the feed is unreachable, stale, or empty.
# "demo": replay the real schedule compressed into NUXT_DEMO_CYCLE_SECONDS.
#         The only mode that shows a "SALIENDO" state after a trip departs.
NUXT_OPERATION_MODE=fake

# --- Target stop -------------------------------------------------------------
# GTFS stop_id to display. bUCR_0_01 is "Educacion".
# Which stop_times count as boardable is inferred from the feed (not the trip's
# last stop_sequence, and not pickup_type=1), so this needs nothing alongside it.
NUXT_STOP_ID=bUCR_0_01

# --- Static GTFS Schedule ----------------------------------------------------
NUXT_GTFS_FEED_URL=https://feeds.simovi.org/bucr/schedule/gtfs.zip
# How often to re-download and re-parse the feed. The refresh happens in the
# background: requests keep being served from the existing copy, so a slow
# feed host never blocks the board.
NUXT_GTFS_REFRESH_INTERVAL_SECONDS=21600
# Deadline for the feed download. On timeout the app keeps its in-memory
# copy, falling back to the on-disk zip cache if it has none.
NUXT_GTFS_FETCH_TIMEOUT_MS=15000

# --- Databus (real-time) -----------------------------------------------------
# NOTE: this host does not currently resolve. Confirm the real URL before
# relying on "real" mode -- and note the board shows the same "EN VIVO" badge
# whether live data or the schedule fallback is driving it, so a wrong URL
# here is not visible on screen. Check `docker compose logs`.
# The app appends /feed/realtime/trip_updates.json to this base.
NUXT_DATABUS_BASE_URL=https://databus.bucr.digital
# A trip_updates feed older than this (by its own header timestamp), or with
# no entries for NUXT_STOP_ID, is treated as unhealthy -> fall back to the
# schedule for that response.
NUXT_REALTIME_STALE_THRESHOLD_SECONDS=90
# Per-request timeout when fetching the Databus feed.
NUXT_REALTIME_FETCH_TIMEOUT_MS=5000

# --- Demo mode ---------------------------------------------------------------
# Real seconds for one full replay of the represented day's schedule. A
# schedule spanning 06:00-22:00 (57600s) at 900 runs 64x.
NUXT_DEMO_CYCLE_SECONDS=900
# How long a departed trip stays in its "SALIENDO" state before leaving the
# board. Schedule-equivalent seconds, not wall-clock: at 64x, 180 here is
# under 3 real seconds on screen.
NUXT_DEMO_DEPARTING_GRACE_SECONDS=180

# --- Frontend ----------------------------------------------------------------
# How often the page polls /api/arrivals in real/fake mode.
NUXT_PUBLIC_REFRESH_INTERVAL_SECONDS=15
# Same for demo mode, which needs closer polling because its clock is
# compressed and would otherwise jump in large steps.
NUXT_PUBLIC_DEMO_REFRESH_INTERVAL_SECONDS=3
# Max number of upcoming departures shown on screen.
NUXT_PUBLIC_MAX_ARRIVALS=4

# --- Server ------------------------------------------------------------------
# Used only by compose.yml, to pick the host-side port. The container's
# internal port is fixed at 3000.
HOST_PORT=3000
