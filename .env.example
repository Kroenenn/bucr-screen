# Copy to .env and adjust.
#
# All of these (except HOST_PORT) are read by Nuxt's runtimeConfig via its
# own NUXT_<KEY> environment variable convention, at container *start* time
# -- not baked into the image at build time. That's what makes "change
# OPERATION_MODE, restart the container" work without a rebuild. See
# nuxt.config.ts's runtimeConfig block for the literal defaults these
# override.

# --- Operation mode ---------------------------------------------------------
# "real": poll Databus for live arrivals, auto-fall back to the GTFS schedule
#         when the feed is unreachable or stale.
# "fake": GTFS schedule only, never calls Databus.
# "demo": a synthetic, densely-spaced departure sequence (3-5 min gaps, real
#         destinations pulled from the GTFS data) -- for previewing/testing
#         the board without waiting out bUCR's real ~20-35 minute gaps. Also
#         the only mode that shows a "SALIENDO" departing state after a trip
#         passes (real/fake remove it immediately, matching MBTA's own
#         Real-Time Display Guidelines -- see NUXT_DEMO_DEPARTING_GRACE_SECONDS
#         below and PLAN.md for why).
NUXT_OPERATION_MODE=real

# --- Target stop -------------------------------------------------------------
# GTFS stop_id to display. Default is "Educacion" (bUCR_0_01).
NUXT_STOP_ID=bUCR_0_01
# Which GTFS direction_id actually departs from NUXT_STOP_ID (0 or 1).
# bUCR_0_01 is a two-way terminus: direction 0 trips start there (boardable,
# real destination "Odontologia"), direction 1 trips END there (trip_headsign
# is "Educacion" itself -- NOT boardable, just a bus finishing its route).
# Without this filter the board would show "Educacion" as a fake destination
# for buses you can't actually get on. Change this alongside NUXT_STOP_ID if
# it's ever pointed at a different stop.
NUXT_STOP_DIRECTION_ID=0

# --- Static GTFS Schedule ----------------------------------------------------
NUXT_GTFS_FEED_URL=https://feeds.simovi.org/bucr/schedule/gtfs.zip
# How often to re-download and re-parse the static feed (schedule data
# rarely changes intra-day).
NUXT_GTFS_REFRESH_INTERVAL_SECONDS=21600

# --- Databus (real-time) -----------------------------------------------------
# Verify this is the correct production URL before the event (see PLAN.md).
NUXT_DATABUS_BASE_URL=https://databus.bucr.digital
# There's no separate server-side poll loop -- every /api/arrivals request
# in "real" mode fetches Databus fresh, so the effective poll cadence is
# whatever NUXT_PUBLIC_REFRESH_INTERVAL_SECONDS below is set to.
# A trip_updates feed older than this (by its own header timestamp), or one
# with no entries for STOP_ID, is treated as unhealthy -> fall back to the
# GTFS schedule for that response.
NUXT_REALTIME_STALE_THRESHOLD_SECONDS=90
# Per-request timeout when fetching the Databus feed.
NUXT_REALTIME_FETCH_TIMEOUT_MS=5000

# --- Demo mode -----------------------------------------------------------------
# How long a departed synthetic trip stays visible in its "SALIENDO"
# departing state (pulsing dot, replaces the countdown) before being
# removed from the board. Departure spacing itself (3-5 min) is not
# configurable -- see server/utils/demo-mode.ts's GAP_PATTERN_SECONDS.
NUXT_DEMO_DEPARTING_GRACE_SECONDS=180

# --- Frontend -----------------------------------------------------------------
# How often the kiosk page polls /api/arrivals. Demo mode runs at normal
# real-time pace (no acceleration), so this one interval covers all modes.
NUXT_PUBLIC_REFRESH_INTERVAL_SECONDS=15
# Max number of upcoming departures shown on screen.
NUXT_PUBLIC_MAX_ARRIVALS=5

# --- Server --------------------------------------------------------------------
# Only used by `docker-compose.yml`, to pick the host-side port. The
# container's internal port is fixed at 3000 (see Dockerfile) so this is
# purely "which port on the Pi's network do I expose this on".
HOST_PORT=3000
